{
  "name": "render-file-tokenizer",
  "version": "1.0.0",
  "type": "module",
  "description": "Kostenloser Offline-Tokenizer optimiert für Render",
  "main": "server.js",
  "scripts": {
    "build": "node -e \"import('@xenova/transformers').then(t => t.AutoTokenizer.from_pretrained('Xenova/gpt2'))\"",
    "start": "node server.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "express": "^4.19.2"
  }
}
